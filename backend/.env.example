# Backend Environment Variables Template
APP_ENV=production
APP_NAME=AI VERSE
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Firebase Project Configuration
FIREBASE_PROJECT_ID=ai-verse-7ac4e
FIREBASE_DATABASE_ID=(default)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Cryptographic Hash Secrets (Generate random 32+ char strings in production)
WORKER_TOKEN_HASH_SECRET=verse_worker_sec_ai_verse_7ac4e_prod_32char_key
API_KEY_HASH_SECRET=verse_api_sec_ai_verse_7ac4e_prod_32char_key

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=https://ai-verse.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Queue & Timeouts
REQUEST_TIMEOUT_SECONDS=120
WORKER_HEARTBEAT_TIMEOUT_SECONDS=45
JOB_LEASE_SECONDS=60
MAX_JOB_RETRIES=2
LOG_LEVEL=INFO
